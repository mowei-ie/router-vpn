# 本文件只列出环境变量名和用途说明，不包含任何真实密钥/token。
# 复制为 .env 后按需填入真实值；.env 已在 .gitignore 中排除，不会被提交。
# 凭证分别在 Google Search Console、Cloudflare Web Analytics 控制台获取。

# Google Search Console 站点验证 meta 标签内容。未设置时该 meta 标签不会渲染，不会报错。
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Web Analytics 的 beacon token。未设置时不会注入任何分析脚本。
PUBLIC_CF_BEACON_TOKEN=

# 广告适配层总开关。设为 "true" 才会尝试展示广告位（仍受访客同意 Cookie 状态和
# getAdProvider() 地域判断门控）；留空或任意其他值都视为关闭。
PUBLIC_ADS_ENABLED=
