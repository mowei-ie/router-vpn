---
import { CATEGORIES, CATEGORY_ORDER } from "../lib/categories";

const navLinks = [
  { href: "/", label: "首页" },
  ...CATEGORY_ORDER.map((slug) => ({
    href: `/${slug}/`,
    label: CATEGORIES[slug].shortLabel,
  })),
  { href: "/about/", label: "关于" },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="border-b border-slate-200 bg-white/95 backdrop-blur sticky top-0 z-30">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-slate-900">
      <span aria-hidden="true">🤖</span>
      <span>AI 编程实战教程</span>
    </a>

    <!-- 桌面导航：纯 CSS 响应式隐藏/显示，无需 JavaScript -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-full px-3 py-1.5 transition-colors",
            isActive(link.href)
              ? "bg-sky-600 text-white"
              : "text-slate-700 hover:bg-slate-100",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- 移动端导航：原生 <details>/<summary> 折叠菜单，纯 HTML/CSS，无 JS 依赖 -->
    <details class="md:hidden relative">
      <summary
        class="cursor-pointer list-none rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700"
      >
        菜单
      </summary>
      <nav
        class="absolute right-0 z-40 mt-2 flex w-48 flex-col gap-1 rounded-lg border border-slate-200 bg-white p-2 shadow-lg"
      >
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-md px-3 py-2 text-sm",
              isActive(link.href)
                ? "bg-sky-600 text-white"
                : "text-slate-700 hover:bg-slate-100",
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
