---
/**
 * ConsentBanner.astro
 *
 * 首次访问时在页面底部提示"本站使用广告 Cookie"，提供同意/拒绝两个按钮。
 * 纯 localStorage 记忆同意状态，不依赖任何第三方同意管理 SDK。
 * 广告适配层（AdSlot）监听这个同意状态，拒绝时不加载广告脚本；同意后如果当前页面还在，
 * 会实时补充加载。
 *
 * 注意：Cloudflare Web Analytics（见 Analytics.astro）不使用 Cookie/跨站跟踪，已经不再
 * 受这个同意状态门控，因此文案只提"广告 Cookie"，不再提"分析"。
 */
---

<div
  id="consent-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-slate-200 bg-white/95 px-4 py-4 shadow-[0_-4px_12px_rgba(0,0,0,0.08)] backdrop-blur sm:px-6"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie 同意提示"
>
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-3 text-sm text-slate-700 sm:flex-row sm:justify-between">
    <p class="leading-6">
      本站可能使用个性化广告 Cookie（仅在部分地区、部分广告商可用时才会生效），用于展示广告；
      本站的访问统计（Cloudflare Web Analytics）不使用 Cookie，不受此提示影响。
      详见<a class="underline hover:text-sky-700" href="/privacy/">隐私政策</a>。
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        id="consent-decline"
        class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100"
      >
        拒绝
      </button>
      <button
        type="button"
        id="consent-accept"
        class="rounded-full bg-sky-700 px-4 py-1.5 text-sm font-medium text-white hover:bg-sky-800"
      >
        同意
      </button>
    </div>
  </div>
</div>

<script>
  import { getConsent, setConsent } from "../lib/consent-client.js";

  const banner = document.getElementById("consent-banner");
  const acceptBtn = document.getElementById("consent-accept");
  const declineBtn = document.getElementById("consent-decline");

  if (banner && acceptBtn && declineBtn) {
    if (getConsent() === null) {
      banner.classList.remove("hidden");
    }

    acceptBtn.addEventListener("click", () => {
      setConsent("granted");
      banner.classList.add("hidden");
    });

    declineBtn.addEventListener("click", () => {
      setConsent("denied");
      banner.classList.add("hidden");
    });
  }
</script>
