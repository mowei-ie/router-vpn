---
import type { CollectionEntry } from "astro:content";
import { tagSlug } from "../lib/tag-stats.mjs";

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry } = Astro.props;
const { title, description, updatedDate, pubDate, tags } = entry.data;

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="rounded-xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md">
  <h3 class="text-lg font-semibold text-slate-900">
    <a class="hover:text-sky-700 hover:underline" href={`/${entry.id}/`}>{title}</a>
  </h3>
  <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
  <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-slate-500">
    <span>更新：{dateFormatter.format(updatedDate ?? pubDate)}</span>
  </div>
  <ul class="mt-3 flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tagSlug(tag)}/`}
          class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-600 hover:bg-sky-100 hover:text-sky-700"
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
</article>
