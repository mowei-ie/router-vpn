---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { CATEGORIES } from "../../lib/categories";

const meta = CATEGORIES.cursor;

const introEntry = await getEntry("sectionIntros", "cursor/readme");
const introRendered = introEntry ? await render(introEntry) : null;
const IntroContent = introRendered?.Content;

const articles = (
  await getCollection("articles", ({ data }) => !data.draft && data.category === "cursor")
).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<BaseLayout title={meta.label} description={meta.description}>
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900">{meta.label}</h1>
    <p class="mt-2 text-slate-600">{meta.description}</p>
  </header>

  {IntroContent && (
    <div class="prose-article mb-10 rounded-xl border border-slate-200 bg-white p-6">
      <IntroContent />
    </div>
  )}

  <section>
    <h2 class="text-xl font-bold text-slate-900">全部文章（共 {articles.length} 篇）</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {articles.map((entry) => (
        <ArticleCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>
