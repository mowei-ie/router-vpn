---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { TAG_INDEX_MIN_ARTICLES, tagSlug } from "../../lib/tag-stats.mjs";
import { SITE_NAME } from "../../lib/site";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  for (const entry of articles) {
    for (const tag of entry.data.tags) {
      tagSet.add(tag);
    }
  }

  const slugToTag = new Map<string, string>();
  for (const tag of tagSet) {
    const slug = tagSlug(tag);
    const existing = slugToTag.get(slug);
    if (existing !== undefined && existing !== tag) {
      throw new Error(
        `标签 slug 冲突："${existing}" 与 "${tag}" 均映射为 "${slug}"`,
      );
    }
    slugToTag.set(slug, tag);
  }

  return [...tagSet].map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: {
      tag,
      entries: articles.filter((entry) => entry.data.tags.includes(tag)),
    },
  }));
}

const { tag, entries } = Astro.props as {
  tag: string;
  entries: CollectionEntry<"articles">[];
};

/**
 * 标签页 meta description：一句自然中文，信息前置（标签名 + 篇数在最前面，命中新规则要求的
 * "核心信息放在前 70 字内"），不为了凑字数拼接固定尾句或堆砌全部文章标题。
 * 单篇/多篇分别给出对应的自然表述，长度落在建议区间 70-110 字左右。
 */
function buildDescription(tagName: string, list: CollectionEntry<"articles">[]): string {
  if (list.length === 1) {
    const [only] = list;
    return `${SITE_NAME}「${tagName}」标签下的教程：《${only.data.title}》，提供可直接落地的操作步骤、命令示例与风险边界提示，欢迎点击标签页查看完整实战内容。`;
  }

  return `${SITE_NAME}「${tagName}」标签下共收录 ${list.length} 篇教程，系统覆盖该主题的实战步骤、工程流程、配置方法与常见问题排查经验，方便你按标签快速定位并查阅全部相关内容。`;
}

const description = buildDescription(tag, entries);
const title = `#${tag} 实战教程合集（共 ${entries.length} 篇文章）`;

// 稀薄标签页（非 draft 文章数 < TAG_INDEX_MIN_ARTICLES）noindex，避免索引膨胀；
// 对应地从 sitemap 剔除的逻辑在 astro.config.mjs 里，两边共用 src/lib/tag-stats.mjs 的统计与阈值。
const robots = entries.length < TAG_INDEX_MIN_ARTICLES ? "noindex, follow" : "index, follow";

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "标签索引", url: "/tags/" },
  { name: `标签：${tag}`, url: `/tags/${tagSlug(tag)}/` },
];
---

<BaseLayout title={title} description={description} robots={robots} breadcrumbs={breadcrumbs}>
  <nav class="mb-4 text-sm text-slate-500">
    <a class="hover:text-sky-700 hover:underline" href="/tags/">全部标签</a>
  </nav>
  <h1 class="text-3xl font-bold text-slate-900">#{tag}</h1>
  <p class="mt-2 text-slate-600">共 {entries.length} 篇文章</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {entries.map((entry) => (
      <ArticleCard entry={entry} />
    ))}
  </div>
</BaseLayout>
