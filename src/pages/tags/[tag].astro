---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  for (const entry of articles) {
    for (const tag of entry.data.tags) {
      tagSet.add(tag);
    }
  }

  return [...tagSet].map((tag) => ({
    params: { tag },
    props: {
      entries: articles.filter((entry) => entry.data.tags.includes(tag)),
    },
  }));
}

const { tag } = Astro.params;
const { entries } = Astro.props;

const description = `本页聚合了 AI 编程实战教程站中标签为「${tag}」的全部 ${entries.length} 篇文章，涵盖 Cursor、ChatGPT、OpenAI API 与 OpenAI Codex 相关的实战步骤、工程流程与风险边界，方便你按这个主题标签快速查找全部相关教程内容。`;

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "标签索引", url: "/tags/" },
  { name: `标签：${tag}`, url: `/tags/${encodeURIComponent(tag)}/` },
];
---

<BaseLayout title={`标签：${tag}`} description={description} breadcrumbs={breadcrumbs}>
  <nav class="mb-4 text-sm text-slate-500">
    <a class="hover:text-sky-700 hover:underline" href="/tags/">全部标签</a>
  </nav>
  <h1 class="text-3xl font-bold text-slate-900">#{tag}</h1>
  <p class="mt-2 text-slate-600">共 {entries.length} 篇文章</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {entries.map((entry) => (
      <ArticleCard entry={entry} />
    ))}
  </div>
</BaseLayout>
