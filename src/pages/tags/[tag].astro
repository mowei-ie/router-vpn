---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { TAG_INDEX_MIN_ARTICLES, tagSlug } from "../../lib/tag-stats.mjs";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  for (const entry of articles) {
    for (const tag of entry.data.tags) {
      tagSet.add(tag);
    }
  }

  return [...tagSet].map((tag) => ({
    params: { tag },
    props: {
      entries: articles.filter((entry) => entry.data.tags.includes(tag)),
    },
  }));
}

const { tag } = Astro.params;
const { entries } = Astro.props as { entries: CollectionEntry<"articles">[] };

/**
 * 标签页 meta description 生成策略（避免 63+ 个标签页共用一句模板化死文案）：
 *   - 引用该标签下真实文章的标题（和单篇时的真实简介片段），保证内容准确、逐标签不同；
 *   - 用 clampToRange 把拼接结果收敛到 150-160 字符，优先在中文标点处断句，
 *     避免把无意义的空话堆进来凑字数。
 * 因为绝大多数标签下只有 1 篇文章，单篇/多篇分别设计拼接策略：
 *   - 单篇：标签名 + 该文章标题 + 该文章自身 description 的开头片段；
 *   - 多篇：标签名 + 篇数 + 全部文章标题列表，必要时追加第一篇文章的简介片段补足长度。
 */
function clampToRange(text: string, min = 150, max = 160): string {
  if (text.length <= max) return text;
  for (let i = max; i >= min; i -= 1) {
    if ("，。；、".includes(text[i - 1])) return text.slice(0, i);
  }
  return `${text.slice(0, max - 1)}…`;
}

function buildDescription(tagName: string, list: CollectionEntry<"articles">[]): string {
  if (list.length === 1) {
    const [only] = list;
    const prefix = `AI 编程实战教程站「${tagName}」标签下收录教程《${only.data.title}》：`;
    return clampToRange(prefix + only.data.description);
  }

  const titleList = list.map((entry) => `《${entry.data.title}》`).join("、");
  const prefix = `AI 编程实战教程站「${tagName}」标签下共收录 ${list.length} 篇教程：${titleList}，`;
  const withFallbackTail = `${prefix}覆盖该主题下的实战步骤、工程流程与注意事项，方便你按标签快速查找全部相关教程内容。`;
  const raw = withFallbackTail.length >= 150 ? withFallbackTail : prefix + list[0].data.description;
  return clampToRange(raw);
}

const description = buildDescription(tag, entries);
const title = `#${tag} 实战教程合集（共 ${entries.length} 篇文章）`;

// 稀薄标签页（非 draft 文章数 < TAG_INDEX_MIN_ARTICLES）noindex，避免索引膨胀；
// 对应地从 sitemap 剔除的逻辑在 astro.config.mjs 里，两边共用 src/lib/tag-stats.mjs 的统计与阈值。
const robots = entries.length < TAG_INDEX_MIN_ARTICLES ? "noindex, follow" : "index, follow";

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "标签索引", url: "/tags/" },
  { name: `标签：${tag}`, url: `/tags/${tagSlug(tag)}/` },
];
---

<BaseLayout title={title} description={description} robots={robots} breadcrumbs={breadcrumbs}>
  <nav class="mb-4 text-sm text-slate-500">
    <a class="hover:text-sky-700 hover:underline" href="/tags/">全部标签</a>
  </nav>
  <h1 class="text-3xl font-bold text-slate-900">#{tag}</h1>
  <p class="mt-2 text-slate-600">共 {entries.length} 篇文章</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {entries.map((entry) => (
      <ArticleCard entry={entry} />
    ))}
  </div>
</BaseLayout>
