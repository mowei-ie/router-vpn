---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = await getCollection("articles", ({ data }) => !data.draft);

const tagCounts = new Map<string, number>();
for (const entry of articles) {
  for (const tag of entry.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="标签索引" description="按标签浏览 AI 编程实战教程站的全部文章。">
  <h1 class="text-3xl font-bold text-slate-900">标签索引</h1>
  <p class="mt-2 text-slate-600">共 {tags.length} 个标签，点击查看对应文章列表。</p>
  <ul class="mt-6 flex flex-wrap gap-2">
    {tags.map(([tag, count]) => (
      <li>
        <a
          href={`/tags/${encodeURIComponent(tag)}/`}
          class="rounded-full bg-sky-50 px-3 py-1.5 text-sm font-medium text-sky-700 hover:bg-sky-100"
        >
          #{tag} <span class="text-sky-400">({count})</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
