---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = await getCollection("articles", ({ data }) => !data.draft);

const tagCounts = new Map<string, number>();
for (const entry of articles) {
  for (const tag of entry.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "标签索引", url: "/tags/" },
];

const description = `标签索引：本页汇总本站全部 ${articles.length} 篇教程按 ${tags.length} 个主题标签的分类入口，覆盖 Cursor、ChatGPT、OpenAI API 与 OpenAI Codex 相关的套餐定价、模型选择、Agent 与安全审批、部署上线、系统排障等主题，点击任意标签即可查看该主题下的全部教程列表，方便你按兴趣快速定位内容。`;
---

<BaseLayout
  title="全部标签索引：按主题快速浏览教程内容"
  description={description}
  breadcrumbs={breadcrumbs}
>
  <h1 class="text-3xl font-bold text-slate-900">标签索引</h1>
  <p class="mt-2 text-slate-600">共 {tags.length} 个标签，点击查看对应文章列表。</p>
  <ul class="mt-6 flex flex-wrap gap-2">
    {tags.map(([tag, count]) => (
      <li>
        <a
          href={`/tags/${encodeURIComponent(tag)}/`}
          class="rounded-full bg-sky-50 px-3 py-1.5 text-sm font-medium text-sky-700 hover:bg-sky-100"
        >
          #{tag} <span class="text-sky-400">({count})</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
