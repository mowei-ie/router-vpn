---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { CATEGORIES, CATEGORY_ORDER } from "../lib/categories";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);

const latestArticles = [...allArticles]
  .sort((a, b) => {
    const aDate = (a.data.updatedDate ?? a.data.pubDate).getTime();
    const bDate = (b.data.updatedDate ?? b.data.pubDate).getTime();
    return bDate - aDate;
  })
  .slice(0, 6);

const pageDescription =
  "中文 AI 编程与效率工具教程站：系统整理 Cursor、ChatGPT、OpenAI API 与 OpenAI Codex 的实战步骤、工程流程与风险边界。";
---

<BaseLayout title="AI 编程实战教程" description={pageDescription}>
  <section class="rounded-2xl bg-gradient-to-br from-sky-600 to-indigo-700 px-6 py-14 text-white sm:px-10">
    <h1 class="text-3xl font-bold sm:text-4xl">AI 编程与效率工具中文实战教程</h1>
    <p class="mt-4 max-w-2xl text-base leading-7 text-sky-50 sm:text-lg">
      围绕 Cursor、ChatGPT、OpenAI API 与 OpenAI Codex，提供可执行步骤、工程流程、风险边界与版本核验，帮助中文读者把
      AI 编程助手真正用进日常开发与运维工作。
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      {CATEGORY_ORDER.map((slug) => (
        <a
          href={`/${slug}/`}
          class="rounded-full bg-white/15 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/40 transition-colors hover:bg-white/25"
        >
          {CATEGORIES[slug].label} →
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-bold text-slate-900">专题入口</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {CATEGORY_ORDER.map((slug) => {
        const meta = CATEGORIES[slug];
        const count = allArticles.filter((a) => a.data.category === slug).length;
        return (
          <a
            href={`/${slug}/`}
            class="block rounded-xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-md"
          >
            <h3 class="text-lg font-semibold text-slate-900">{meta.label}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{meta.description}</p>
            <p class="mt-3 text-xs font-medium text-sky-700">共 {count} 篇文章 →</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-bold text-slate-900">最新更新</h2>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {latestArticles.map((entry) => (
        <ArticleCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>
