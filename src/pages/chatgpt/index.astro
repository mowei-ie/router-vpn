---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { CATEGORIES } from "../../lib/categories";

const meta = CATEGORIES.chatgpt;

const articles = (
  await getCollection("articles", ({ data }) => !data.draft && data.category === "chatgpt")
).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: meta.label, url: `/${meta.slug}/` },
];
---

<BaseLayout title={meta.label} description={meta.description} breadcrumbs={breadcrumbs}>
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900">{meta.label}</h1>
    <p class="mt-2 text-slate-600">{meta.description}</p>
  </header>

  <div class="prose-article mb-10 rounded-xl border border-slate-200 bg-white p-6">
    <p>
      本专题覆盖 ChatGPT 个人订阅方案（Free / Go / Plus / Pro）的选择与账单管理，以及
      OpenAI API 的接入方式、密钥安全与成本控制。两者是独立计费的两套产品：ChatGPT
      订阅管理网页与应用内体验，OpenAI API 面向开发者按用量计费接入自有服务。
    </p>
  </div>

  <section>
    <h2 class="text-xl font-bold text-slate-900">全部文章（共 {articles.length} 篇）</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {articles.map((entry) => (
        <ArticleCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>
