---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { CATEGORIES } from "../../lib/categories";

const meta = CATEGORIES.extras;

const articles = (
  await getCollection("articles", ({ data }) => !data.draft && data.category === "extras")
).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: meta.label, url: `/${meta.slug}/` },
];
---

<BaseLayout title={meta.seoTitle} description={meta.description} breadcrumbs={breadcrumbs}>
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900">{meta.label}</h1>
    <p class="mt-2 text-slate-600">{meta.description}</p>
  </header>

  <div class="prose-article mb-10 rounded-xl border border-slate-200 bg-white p-6">
    <p>
      本专题收录与 AI 编程主线相关的扩展实践：自建访问统计服务的部署与优化，以及用
      Tailscale 在没有公网 IP 的情况下安全访问远端 ESXi 管理界面。
    </p>
  </div>

  <section>
    <h2 class="text-xl font-bold text-slate-900">全部文章（共 {articles.length} 篇）</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {articles.map((entry) => (
        <ArticleCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>
