---
import BaseLayout from "./BaseLayout.astro";
import ArticleCopyrightFooter from "../components/ArticleCopyrightFooter.astro";
import AdSlot from "../components/AdSlot.astro";
import { CATEGORIES, type Category } from "../lib/categories";
import { SITE_AUTHOR } from "../lib/site";

interface Props {
  title: string;
  description: string;
  category: Category;
  tags: string[];
  pubDate: Date;
  updatedDate?: Date;
  reviewNotes?: string[];
}

const { title, description, category, tags, pubDate, updatedDate, reviewNotes } = Astro.props;
const categoryMeta = CATEGORIES[category];

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: categoryMeta.label, url: `/${categoryMeta.slug}/` },
  { name: title, url: Astro.url.pathname },
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  keywords={tags}
  breadcrumbs={breadcrumbs}
  article={{
    headline: title,
    description,
    datePublished: pubDate,
    dateModified: updatedDate,
    author: SITE_AUTHOR,
  }}
>
  <nav class="mb-4 text-sm text-slate-500" aria-label="breadcrumb">
    <a class="hover:text-sky-700 hover:underline" href="/">首页</a>
    <span class="px-1">/</span>
    <a class="hover:text-sky-700 hover:underline" href={`/${categoryMeta.slug}/`}>
      {categoryMeta.label}
    </a>
  </nav>

  <article>
    <header class="mb-8 border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-bold leading-tight text-slate-900 sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 text-base text-slate-600">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <span>发布：{dateFormatter.format(pubDate)}</span>
        {updatedDate && <span>· 更新：{dateFormatter.format(updatedDate)}</span>}
      </div>
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li>
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="rounded-full bg-sky-50 px-3 py-1 text-xs font-medium text-sky-700 hover:bg-sky-100"
            >
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    </header>

    <!-- 文首广告位：不接入任何真实广告商，见 src/components/AdSlot.astro 说明。 -->
    <AdSlot placement="in-article" />

    <div class="prose-article">
      <slot />
    </div>

    <!-- 文末广告位。“正文中部”未额外拆分插入：正文以 <slot /> 整段渲染自 Markdown，
         拆开中部位置需要额外的内容分段逻辑，权衡后先只在文首/文末各留一个占位，
         后续如果需要更精细的插入位置，可以在 remark 阶段按段落数插入占位标记后再处理。 -->
    <AdSlot placement="in-article" />

    {/* 复核提示只在本地开发环境渲染，生产构建不输出：这是维护者内部信息，公开会向读者/搜索引擎传递“内容未核完”的负信号 */}
    {import.meta.env.DEV && reviewNotes && reviewNotes.length > 0 && (
      <aside class="mt-10 rounded-lg border border-slate-100 bg-slate-50/60 p-4 text-xs leading-relaxed text-slate-500">
        <p class="font-medium text-slate-500">复核提示（供维护者核对，不代表内容有误；仅开发环境可见）</p>
        <ul class="mt-2 list-disc space-y-1 pl-4">
          {reviewNotes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </aside>
    )}

    <ArticleCopyrightFooter updatedDate={updatedDate ?? pubDate} />
  </article>
</BaseLayout>
